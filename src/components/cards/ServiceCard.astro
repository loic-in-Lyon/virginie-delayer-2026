---
import GlassCard from "../ui/GlassCard.astro";
import Badge from "../ui/Badge.astro";
import Button from "../ui/Button.astro";

interface Props {
  title: string;
  subtitle?: string;
  duree: string;
  prix: string;
  resume: string;
  slug: string;
  collection: "soins" | "formations" | "formations-distance";
  isNew?: boolean;
  featured?: boolean;
}

const {
  title,
  subtitle,
  duree,
  prix,
  resume,
  slug,
  collection,
  isNew = false,
  featured = false,
} = Astro.props;

const baseUrl =
  collection === "formations-distance"
    ? "/formations-distance"
    : `/${collection}`;
---

<GlassCard class="flex flex-col justify-between h-full group">
  <div>
    <!-- Badges & En-tête -->
    <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
      <div class="flex items-center gap-2">
        {isNew && <Badge variant="new">Nouveau</Badge>}
        {featured && <Badge variant="featured">Coup de cœur</Badge>}
      </div>
      <span
        class="text-xs font-semibold text-emerald-800 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200/60"
      >
        {duree}
      </span>
    </div>

    <!-- Titres -->
    <h3
      class="font-serif text-2xl font-bold text-stone-800 group-hover:text-emerald-800 transition-colors mb-1"
    >
      <a href={`${baseUrl}/${slug}`}>{title}</a>
    </h3>

    {
      subtitle && (
        <p class="text-xs font-medium text-emerald-700/80 uppercase tracking-wider mb-3">
          {subtitle}
        </p>
      )
    }

    <!-- Description résumée -->
    <p class="text-sm text-stone-600 line-clamp-3 leading-relaxed mb-6">
      {resume}
    </p>
  </div>

  <!-- Pied de carte : Prix + Action -->
  <div
    class="pt-4 border-t border-stone-200/50 flex items-center justify-between gap-4 mt-auto"
  >
    <div>
      <span class="text-xs text-stone-500 uppercase tracking-wider block"
        >Tarif</span
      >
      <span class="text-xl font-bold text-stone-800 font-serif">{prix} €</span>
    </div>

    <Button href={`${baseUrl}/${slug}`} variant="glass" size="sm">
      En savoir plus
    </Button>
  </div>
</GlassCard>
