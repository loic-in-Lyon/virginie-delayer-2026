---
interface FaqItem {
  question: string;
  answer?: string;
  reponse?: string;
}

interface Props {
  faq?: FaqItem[];
  title?: string;
  subtitle?: string;
}

const {
  faq = [],
  title = "Questions frequentes",
  subtitle = "Tout ce que vous devez savoir avant votre seance",
} = Astro.props;

function removeAccents(str: string) {
  if (!str) return "";
  return str
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/œ/g, "oe")
    .replace(/Œ/g, "OE");
}

const cleanTitle = removeAccents(title);
const cleanSubtitle = removeAccents(subtitle);
---

{
  faq && faq.length > 0 && (
    <section class="vd-faq-section">
      <div class="vd-section-container">
        <div class="vd-section-header">
          <h2 class="vd-section-title">{cleanTitle}</h2>
          <span class="vd-section-subtitle">{cleanSubtitle}</span>
        </div>

        <div class="vd-faq-accordion">
          {faq.map((item, idx) => (
            <details class="vd-glass-card vd-faq-item" open={idx === 0}>
              <summary class="vd-faq-question">
                <span>{item.question}</span>
                <span class="vd-faq-icon">+</span>
              </summary>
              <div class="vd-faq-answer">
                <p>{item.answer || item.reponse}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .vd-faq-section {
    padding: 2.5rem 0 3.5rem 0 !important;
    width: 100% !important;
  }

  .vd-section-container {
    max-width: 820px !important;
    margin: 0 auto !important;
    padding: 0 1.5rem !important;
    box-sizing: border-box !important;
  }

  .vd-section-header {
    text-align: center !important;
    margin-bottom: 2rem !important;
  }

  .vd-section-title {
    font-family: "Nicholas", serif !important;
    font-size: 2.5rem !important;
    color: #4f2613 !important;
    font-weight: 300 !important;
    margin: 0 0 0.25rem 0 !important;
  }

  .vd-section-subtitle {
    display: block !important;
    font-family: "Priestacy", cursive !important;
    font-size: 1.5rem !important;
    color: #882454 !important;
  }

  .vd-glass-card {
    background: rgba(255, 255, 255, 0.95) !important;
    backdrop-filter: blur(12px) !important;
    -webkit-backdrop-filter: blur(12px) !important;
    border: 1px solid rgba(255, 255, 255, 0.95) !important;
    border-radius: 20px !important;
    box-shadow:
      0 8px 25px rgba(136, 36, 84, 0.03),
      inset 0 1px 1px rgba(255, 255, 255, 1) !important;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1) !important;
  }

  .vd-faq-accordion {
    display: flex !important;
    flex-direction: column !important;
    gap: 1rem !important;
    text-align: left !important;
  }

  .vd-faq-item {
    padding: 1.25rem 1.75rem !important;
  }

  .vd-faq-question {
    font-weight: 500 !important;
    color: #4f2613 !important;
    cursor: pointer !important;
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    font-size: 1rem !important;
    list-style: none !important;
  }

  .vd-faq-question::-webkit-details-marker {
    display: none !important;
  }

  .vd-faq-icon {
    font-size: 1.25rem !important;
    color: #882454 !important;
    transition: transform 0.3s ease !important;
  }

  .vd-faq-item[open] .vd-faq-icon {
    transform: rotate(45deg) !important;
  }

  .vd-faq-answer {
    margin-top: 0.85rem !important;
    font-size: 0.9rem !important;
    line-height: 1.65 !important;
    color: #555555 !important;
    font-weight: 300 !important;
  }

  @media (max-width: 640px) {
    .vd-section-title {
      font-size: 2rem !important;
    }
    .vd-section-subtitle {
      font-size: 1.25rem !important;
    }
  }
</style>
