---
import GlassCard from "../ui/GlassCard.astro";

interface Props {
  title: string;
  subtitle?: string;
  items?: string[];
  reversed?: boolean;
  class?: string;
}

const {
  title,
  subtitle,
  items = [],
  reversed = false,
  class: className = "",
} = Astro.props;
---

<section class:list={["py-12 sm:py-16", className]}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div
      class:list={[
        "grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center",
        reversed && "lg:direction-rtl",
      ]}
    >
      <!-- Colonne Titre & Présentation -->
      <div class="lg:col-span-5 space-y-4">
        {
          subtitle && (
            <span class="text-xs font-semibold uppercase tracking-widest text-emerald-700 bg-emerald-100/60 px-3 py-1 rounded-full border border-emerald-200/50 inline-block">
              {subtitle}
            </span>
          )
        }
        <h2
          class="font-serif text-3xl sm:text-4xl font-bold text-stone-800 leading-tight"
        >
          {title}
        </h2>
        <div class="text-stone-600 leading-relaxed space-y-4">
          <slot />
        </div>
      </div>

      <!-- Colonne Cartes & Puces de contenu -->
      <div class="lg:col-span-7">
        <GlassCard class="p-6 sm:p-8 space-y-4">
          {
            items.map((item, index) => (
              <div class="flex items-start gap-4 p-3 rounded-xl hover:bg-white/40 transition-colors">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-800 font-bold text-xs">
                  {index + 1}
                </span>
                <p class="text-sm sm:text-base text-stone-700 font-medium leading-relaxed pt-0.5">
                  {item}
                </p>
              </div>
            ))
          }
        </GlassCard>
      </div>
    </div>
  </div>
</section>
