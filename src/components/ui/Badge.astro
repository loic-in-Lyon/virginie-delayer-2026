---
interface Props {
  variant?: "new" | "featured" | "info" | "neutral";
  class?: string;
}

const { variant = "info", class: className = "" } = Astro.props;

const variants = {
  new: "bg-emerald-500/10 text-emerald-700 border-emerald-500/20",
  featured: "bg-amber-500/10 text-amber-700 border-amber-500/20",
  info: "bg-teal-500/10 text-teal-700 border-teal-500/20",
  neutral: "bg-slate-500/10 text-slate-700 border-slate-500/20",
};
---

<span
  class:list={[
    "inline-flex items-center rounded-full border px-3 py-1 text-xs font-medium tracking-wide uppercase backdrop-blur-sm",
    variants[variant],
    className,
  ]}
>
  <slot />
</span>
